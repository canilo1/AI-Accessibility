{
  "name": "tax-fraud-detection-backend",
  "version": "1.0.0",
  "description": "Tax fraud detection backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "ts-node --transpile-only src/db/seed.ts",
    "test": "npm run build && node --test test/*.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^18.0.9",
    "express": "^4.18.3",
